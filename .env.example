# =============================================================================
# Vanilla Export Intelligence Platform (VEIP) — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/veip_db?schema=public"

# -----------------------------------------------------------------------------
# NextAuth.js v5
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Redis (BullMQ job queues)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Or for Redis Cloud / Upstash:
# REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# -----------------------------------------------------------------------------
# OpenAI (LangChain.js — GPT-4o for proposal generation & agent reasoning)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."

# -----------------------------------------------------------------------------
# Resend (Email delivery for buyer proposals)
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="proposals@yourdomain.com"

# -----------------------------------------------------------------------------
# External Data Sources — Market Intelligence
# -----------------------------------------------------------------------------
# World Bank Commodity Price API (no key required, but set base URL)
WORLD_BANK_API_BASE_URL="https://api.worldbank.org/v2"

# Optional: Commodity price data provider API key
COMMODITY_API_KEY=""

# -----------------------------------------------------------------------------
# External Data Sources — Compliance
# -----------------------------------------------------------------------------
# FDA Import Alerts RSS / API
FDA_API_BASE_URL="https://api.fda.gov"

# EU Pesticide MRL Database
EU_MRL_API_BASE_URL="https://ec.europa.eu/food/plant/pesticides/eu-pesticides-database"

# Freight rate data provider (e.g., Freightos, Xeneta)
FREIGHT_RATE_API_KEY=""
FREIGHT_RATE_API_BASE_URL=""

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Optional: LangSmith tracing (LangChain observability)
# -----------------------------------------------------------------------------
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="ls__..."
# LANGCHAIN_PROJECT="veip"
